<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgIconOnboarding1"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:padding="12dp"
        app:layout_constraintBottom_toTopOf="@id/tvTitleOnboarding1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        android:scaleType="centerInside"/>

    <TextView
        android:id="@+id/tvTitleOnboarding1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="Explore With AR!"
        android:textSize="35sp"
        android:textStyle="bold"
        android:fontFamily="@font/internormal"
        app:layout_constraintBottom_toTopOf="@id/tvOnboardingExplaination1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgIconOnboarding1" />

    <TextView
        android:id="@+id/tvOnboardingExplaination1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Experience ancient Ratu Boko temple through cutting edge AR technology. See historical reconstruction come to life."
        android:textColor="@color/black"
        android:textSize="15sp"
        android:fontFamily="@font/internormal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitleOnboarding1" />

</androidx.constraintlayout.widget.ConstraintLayout>